# Copia de ejemplo de las variables de entorno.
# En tu ordenador: `npm run entorno:local` crea .env.local con las claves de la base de datos local.
# En producción: estas variables se ponen en Vercel (Settings → Environment Variables).
# NUNCA subas .env.local al repositorio (ya está excluido en .gitignore).

# Supabase (Project Settings → API Keys en el panel de Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo en el servidor, nunca en el navegador
SUPABASE_SECRET_KEY=

# Dirección de la web (para los enlaces de los emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña de los usuarios de la demo (SOLO en tu ordenador, nunca en producción)
DEMO_CONTRASENA=demo-sevilla-2026
